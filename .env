# ============================================================================
# .env - PostgreSQL Docker Compose Configuration (LOCAL DEVELOPMENT)
# ============================================================================
#
# PURPOSE:
#   Local development environment configuration
#   Copy values from .env.example and customize
#   NEVER commit to git
#
# SECURITY:
#   - Generated password below (use a password manager)
#   - Change POSTGRES_PASSWORD in production
#   - Store secrets in HashiCorp Vault / AWS Secrets Manager for production
#
# PERSPECTIVE: Security - local development with generated credentials
# PERSPECTIVE: Maintainability - development-friendly configuration
#
# ============================================================================

# =============================================================================
# DATABASE CREDENTIALS
# =============================================================================

# PostgreSQL Superuser Username
# DEVELOPMENT: 'postgres' simplifies connections
# PRODUCTION: Use app-specific user with limited permissions
POSTGRES_USER=postgres

# PostgreSQL Superuser Password
# SECURITY: Generated random password - CHANGE FOR PRODUCTION
# Generate your own: openssl rand -base64 32
# Example: aB3+cD4/eF5!gH6%iJ7&kL8*mN9(oP0
POSTGRES_PASSWORD=change_me_to_strong_password_12_chars_minimum

# Default Database Name
POSTGRES_DB=postgres

# =============================================================================
# DATABASE INITIALIZATION
# =============================================================================

# PostgreSQL initialization arguments
# Loads pgvector extension at startup
# Development settings - tune for your hardware
POSTGRES_INITDB_ARGS=-c shared_preload_libraries=vector

# =============================================================================
# OPTIONAL: ADVANCED CONFIGURATION (uncomment as needed)
# =============================================================================

# PostgreSQL configuration file (ADVANCED)
# POSTGRES_CONFIG_FILE=/path/to/postgresql.conf

# PostgreSQL password authentication (ADVANCED)
# Leave blank for scram-sha-256 (default in PostgreSQL 16)
# POSTGRES_HOST_AUTH_METHOD=trust  # (only for dev - not production!)

# =============================================================================
# DOCKER COMPOSE VARIABLES
# =============================================================================

# PostgreSQL Container Name
POSTGRES_CONTAINER_NAME=postgres-pgvector

# Docker image version
# PG_VERSION=16

# Volume names (auto-generated by docker-compose)
# POSTGRES_VOLUME_DATA=postgres_data_dev
# POSTGRES_VOLUME_BACKUP=postgres_backup_dev

# =============================================================================
# ENVIRONMENT TAGS (for identifying deployment environment)
# =============================================================================

# Deployment environment
ENVIRONMENT=development

# Deployment profile name
PROFILE=local

# =============================================================================
# PERSPECTIVE CHECKLIST
# =============================================================================
#
# ✓ Maintainability
#   - Clear variable names
#   - Comments explain each setting
#   - Environment tags for quick identification
#
# ✓ Testability
#   - Easy to create .env.test, .env.prod variants
#   - Values can be swapped for different test scenarios
#
# ✓ Architecture
#   - Follows 12-factor app principles
#   - Configuration separate from code
#   - Environment-aware settings
#
# ✓ Security
#   - No hardcoded secrets in git (this file ignored)
#   - Strong password recommendation
#   - Production: Use secrets management
#
# ✓ Business Value
#   - Quick local setup (copy .env.example → .env)
#   - Clear path to production configuration
#   - Development-friendly defaults
#
# ✓ Documentation
#   - Comprehensive inline comments
#   - Usage examples and best practices
#
# ============================================================================
