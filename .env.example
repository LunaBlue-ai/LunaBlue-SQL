# ============================================================================
# .env.example - PostgreSQL Docker Compose Configuration Template
# ============================================================================
#
# PURPOSE:
#   Template for environment configuration
#   Copy to .env and customize for your deployment
#   NEVER commit .env to git (contains secrets)
#
# USAGE:
#   # Create local development config
#   cp .env.example .env
#   # Edit .env with your values
#   nano .env
#   # Start services
#   docker-compose up -d
#
# SECURITY:
#   - .env files are in .gitignore (don't commit!)
#   - Production: Use Docker Secrets or Kubernetes Secrets
#   - CI/CD: Inject variables via environment, not .env files
#
# PERSPECTIVE: Security - keep .env file out of version control
# PERSPECTIVE: Maintainability - clear template for developers
#
# ============================================================================

# ============================================================================
# DATABASE CREDENTIALS
# ============================================================================

# PostgreSQL Superuser Username
# DEFAULT: postgres
# CHANGE TO: Use a non-standard name for slight security improvement
# CREATED AT: First container startup (PGDATA initialization)
# PERMISSIONS: Full superuser access to all databases
#
# DEVELOPMENT: Use 'postgres' for simplicity
# PRODUCTION: Consider different username for security via obscurity
POSTGRES_USER=postgres

# PostgreSQL Superuser Password
# DEFAULT: (not set in this template - MUST be defined in .env)
# SECURITY CRITICAL:
#   - Minimum 12 characters in production
#   - Use special characters (!@#$%^&*)
#   - Generated example: openssl rand -base64 32
#   - Store securely (password manager, secrets vault)
#
# USAGE:
#   - Set once at database initialization
#   - Cannot be changed via environment (already set)
#   - To change: Must use SQL command or recreate database
#
# PRODUCTION GENERATION:
#   # Generate random password
#   openssl rand -base64 32
#   # Example output: aB3+cD4/eF5!gH6%iJ7&kL8*mN9(oP0)
#
# EXAMPLE:
#   POSTGRES_PASSWORD=aB3+cD4/eF5!gH6%iJ7&kL8*mN9(oP0)
POSTGRES_PASSWORD=change_me_to_strong_password_12_chars_minimum

# Default Database Name
# DEFAULT: postgres (standard for PostgreSQL)
# BEHAVIOR:
#   - Created automatically at first startup
#   - Safe to change between runs
#   - New database created if doesn't exist
# 
# TYPICAL USAGE:
#   Development:   POSTGRES_DB=postgres (or: dev_db)
#   Testing:       POSTGRES_DB=test_db
#   Production:    POSTGRES_DB=production (or: app_db)
POSTGRES_DB=postgres

# ============================================================================
# DATABASE INITIALIZATION
# ============================================================================

# PostgreSQL initialization arguments
# DEFAULT: "-c shared_preload_libraries=vector"
# RATIONALE:
#   - Shared preload libraries load before database initialization
#   - pgvector extension requires vector library to be preloaded
#   - Only used during first startup (when PGDATA is empty)
#
# OPTIONS YOU CAN ADD:
#   -c max_connections=100
#      Connection pool size (tune for your workload)
#      Default: 100 (suitable for small/medium apps)
#      Large apps: 200-1000 (increases memory usage)
#      Default postgres image: 100
#
#   -c shared_buffers=256MB
#      Memory dedicated to caching database pages
#      Default: 128MB (suitable for dev/test)
#      Production rule: 25% of system RAM
#      Example: 8GB RAM → set to 2GB
#
#   -c work_mem=4MB
#      Memory per query operation (sorts, hash tables)
#      Default: 4MB (suitable for general workloads)
#      Large queries: 64-256MB (increases memory consumption)
#      Multiply by max_connections to get total memory needs
#      Example: work_mem=64MB, max_connections=100 → 6.4GB for queries
#
#   -c effective_cache_size=1GB
#      Hint to query planner about available cache
#      Rule: 50-75% of system RAM
#      Helps optimizer choose good execution plans
#
#   -c maintenance_work_mem=128MB
#      Memory for maintenance operations (CREATE INDEX, VACUUM)
#      Default: 64MB
#      Larger = faster index creation and vacuums
#
# COMMON CONFIGURATIONS:
#   Development (laptop):
#     "-c shared_preload_libraries=vector -c max_connections=50 -c shared_buffers=128MB"
#
#   Testing (CI pipeline):
#     "-c shared_preload_libraries=vector -c max_connections=20"
#
#   Production (4GB server):
#     "-c shared_preload_libraries=vector -c max_connections=200 -c shared_buffers=1GB -c work_mem=64MB"
#
#   Production (16GB server):
#     "-c shared_preload_libraries=vector -c max_connections=300 -c shared_buffers=4GB -c work_mem=256MB -c effective_cache_size=12GB"
#
# PERSPECTIVE: Business Value - proper tuning enables high performance
# PERSPECTIVE: Maintainability - easy to adjust for different hardware
POSTGRES_INITDB_ARGS=-c shared_preload_libraries=vector

# ============================================================================
# OPTIONAL: ADVANCED CONFIGURATION
# ============================================================================
# Uncomment these for advanced scenarios

# PostgreSQL configuration file (ADVANCED)
# USAGE: Mount custom postgresql.conf file
# RATIONALE: Some settings cannot be changed via initdb args
# FORMAT: /path/to/postgresql.conf
# NOTE: Only used if provided; docker-compose generates default if not
# POSTGRES_CONFIG_FILE=/path/to/postgresql.conf

# PostgreSQL password authentication (ADVANCED)
# USAGE: Mount custom pg_hba.conf file
# RATIONALE: Control authentication methods and source hosts
# EXAMPLE:
#   - Restrict connections by IP address
#   - Change authentication method (md5, scram-sha-256, etc)
#   - Allow/deny specific users from specific hosts
# POSTGRES_HOST_AUTH_METHOD=trust  # (only for dev - not production!)

# ============================================================================
# DOCKER COMPOSE VARIABLES (For docker-compose.yml templating)
# ============================================================================
# These are not PostgreSQL environment variables
# These control docker-compose behavior

# PostgreSQL Container Name
# DEFAULT: postgres-pgvector (set in docker-compose.yml)
# CHANGE IF: Running multiple containers, need different names
# PERSPECTIVE: Maintainability - easy identification
# COMPOSE_PROJECT_NAME=my-db-project

# Docker image version
# DEFAULT: 16 (set in docker-compose.yml)
# CHANGE IF: Want different PostgreSQL major version
# PG_VERSION=16

# Volume names
# DEFAULT: postgres_data, postgres_backup (auto-generated by docker-compose)
# CHANGE IF: Multiple deployments need separate volumes
# POSTGRES_VOLUME_DATA=postgres_data_prod
# POSTGRES_VOLUME_BACKUP=postgres_backup_prod

# ============================================================================
# PERSPECTIVE CHECKLIST
# ============================================================================
